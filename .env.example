# OpenBudget — environment variables.
# Copy this file to `.env.local` for local dev, and set the same vars in your
# Vercel project (Settings → Environment Variables) for production.
# NEVER commit a file with real values. `.env*` is gitignored.

# ---------------------------------------------------------------------------
# Supabase (your free project: https://supabase.com → New project)
# Settings → API. The SERVICE ROLE key is SECRET and server-only — it bypasses
# Row Level Security. Never expose it to the browser or commit it.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Who is allowed to sign in (comma-separated). FAILS CLOSED: if empty, no one
# can log in. Set this to your own household's email(s).
# ---------------------------------------------------------------------------
ALLOWED_EMAILS=you@example.com,partner@example.com

# ---------------------------------------------------------------------------
# Session signing secret (HMAC). Generate a strong random value:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Magic-link email delivery via Resend (https://resend.com — free tier is fine).
# MAGIC_FROM_EMAIL's domain must be verified in your Resend account. For quick
# testing you can use onboarding@resend.dev (only delivers to your own address).
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
MAGIC_FROM_EMAIL=login@yourdomain.com

# Public URL of your deployment (used to build magic-link URLs). On Vercel you
# can leave this unset and it falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# SimpleFIN Bridge — read-only bank sync (~$15/yr).
# 1. Sign up at https://beta-bridge.simplefin.org/ and connect your bank(s).
# 2. Generate a "setup token", then run:  npm run sync -- claim <SETUP_TOKEN>
# 3. Paste the printed access URL here. (Only needed where you RUN the sync —
#    your dev machine, a cron host, or a CI job. The web app itself does not
#    need it.)
# ---------------------------------------------------------------------------
SIMPLEFIN_ACCESS_URL=https://USER:PASS@beta-bridge.simplefin.org/simplefin

# ---------------------------------------------------------------------------
# Optional niceties
# ---------------------------------------------------------------------------
# App name shown in the UI and login emails.
NEXT_PUBLIC_APP_NAME=OpenBudget
# Only count transactions on/after this date (YYYY-MM-DD). Unset = track all.
# BUDGET_START_DATE=2026-01-01
# A substring to flag your "primary" everyday card in the accounts list.
# PRIMARY_CARD_HINT=
# Return the magic link in the API response for pre-domain-verification testing.
# BUDGET_DEV_MAGIC_LINK=false
